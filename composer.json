{
	"name": "ssswang/sharepoint-graph-client",
	"type": "library",
	"description": "SharePoint client library backed by the Microsoft Graph API",
	"keywords": ["sharepoint", "online", "microsoft", "graph", "oauth", "api", "client"],
	"homepage": "https://github.com/ssswang/sharepoint-graph-client",
	"license": "MIT",
	"require": {
		"php": "^8.1",
		"guzzlehttp/guzzle": "^8.1",
		"firebase/php-jwt": "^7.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^13"
	},
	"autoload": {
		"psr-4": {
			"SharepointGraphClient\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SharepointGraphClient\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
